<group name="local,syslog,sshd,">
  <!-- Détection échec SSH -->
  <rule id="100000" level="5">
    <decoded_as>sshd</decoded_as>
    <match>Failed password</match>
    <description>SSH authentication failed</description>
  </rule>

  <!-- Détection brute force SSH -->
  <rule id="100001" level="10" frequency="5" timeframe="300">
    <if_matched_sid>100000</if_matched_sid>
    <same_source_ip />
    <description>Multiple SSH failures from same IP (Possible brute force)</description>
  </rule>

  <!-- Succès après échecs -->
  <rule id="100002" level="12">
    <if_sid>100001</if_sid>
    <match>Accepted password|Accepted publickey</match>
    <description>Successful SSH login after multiple failures (Suspicious)</description>
    <mitre>
      <id>T1110</id>
      <id>T1021</id>
    </mitre>
  </rule>
</group>
